{
  "name": "pocketflow",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/api run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "build:api": "npm --workspace apps/api run build",
    "deploy:vercel": "npx vercel deploy --prod -y",
    "check:mobile": "cd apps/mobile && npx expo install --check",
    "verify": "npm run typecheck && npm run build:api && npm run check:mobile",
    "typecheck": "npm --workspaces run typecheck"
  },
  "devDependencies": {
    "expo": "~54.0.35"
  }
}
