{
  "name": "pocketflow",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "build:api": "npm --workspace apps/api run build",
    "typecheck": "npm --workspaces run typecheck"
  },
  "devDependencies": {
    "expo": "~54.0.35"
  }
}
